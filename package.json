{
	"name": "everyday-classical-music-plugin",
	"version": "1.1.2",
	"description": "A different classical music piece each day in your Obsidian daily notes.",
	"main": "main.js",
	"scripts": {
		"test": "node --test tests/*.test.cjs",
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint main.ts"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"esbuild": "0.17.3",
		"obsidian": "1.13.1",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
